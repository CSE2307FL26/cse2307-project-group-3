package test;

import main.BankAccount;

import static org.junit.Assert.assertEquals;
import static org.junit.Assert.fail;

import org.junit.jupiter.api.Test;

public class MoneyTransferTest {

    @Test
    public void testMoneyTransfer() {
        BankAccount senderAccount = new BankAccount();
        BankAccount receiverAccount = new BankAccount();

        senderAccount.deposit(100);
        MoneyTransfer moneyTransfer = new MoneyTransfer(100);
        moneyTransfer.transfer(senderAccount.getAccountNumber(), receiverAccount.getAccountNumber(), 50);

        assertEquals(50, senderAccount.getBalance(), 0.01);
        assertEquals(50, receiverAccount.getBalance(), 0.01);

    }

    @Test
    public void testMoneyTransferWithInsufficientFunds() {
        BankAccount senderAccount = new BankAccount();
        BankAccount receiverAccount = new BankAccount();

        senderAccount.deposit(30);
        MoneyTransfer moneyTransfer = new MoneyTransfer();
        moneyTransfer.transfer(senderAccount.getAccountNumber(), receiverAccount.getAccountNumber(), 50);
        assertEquals(30, senderAccount.getBalance(), 0.01);
        assertEquals(0, receiverAccount.getBalance(), 0.01);
    }

    @Test
    public void testMoneyTransferWithInvalidAccountNumber() {
        BankAccount senderAccount = new BankAccount(50);
        MoneyTransfer moneyTransfer = new MoneyTransfer();
        moneyTransfer.transfer(senderAccount.getAccountNumber(), "999", 50);
        assertEquals(50, senderAccount.getBalance(), 0.01);
    }

    @Test
    public void testMoneyTransferWithNegativeAmount() {
        BankAccount senderAccount = new BankAccount(100);
        BankAccount receiverAccount = new BankAccount();
        MoneyTransfer moneyTransfer = new MoneyTransfer();
        moneyTransfer.transfer(senderAccount.getAccountNumber(), receiverAccount.getAccountNumber(), -50);
        assertEquals(100, senderAccount.getBalance(), 0.01);
        assertEquals(0, receiverAccount.getBalance(), 0.01);
    }

    @Test
    public void testMoneyTransferWithSameAccount() {
        BankAccount senderAccount = new BankAccount(100);
        MoneyTransfer moneyTransfer = new MoneyTransfer();
        moneyTransfer.transfer(senderAccount.getAccountNumber(), senderAccount.getAccountNumber(), 50);
        assertEquals(100, senderAccount.getBalance(), 0.01);
    }
}
